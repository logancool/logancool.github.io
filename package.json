{
    "name": "website",
    "version": "1.0",
    "description": "Logan Cool's personal website",
    "main": "index.js",
    "scripts": {
        "build:dev": "webpack --mode=development",
        "build:prod": "webpack --mode=production",
        "serve": "webpack serve --mode=development",
        "serve:prod": "webpack serve --mode=production",
        "start:prod": "npm run build:prod && npm run serve:prod",
        "dev": "webpack serve --mode=development --open",
        "start": "npm run dev",
        "lint:js": "eslint --cache .",
        "lint:style": "stylelint --custom-syntax postcss-scss \"src/**/*.scss\"",
        "lint": "npm run lint:js && npm run lint:style",
        "deploy": "npm run build:prod && gh-pages --branch main --dist dist",
        "publish": "npm run deploy"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/logancool/logancool.github.io.git"
    },
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/logancool/logancool.github.io/issues"
    },
    "homepage": "https://github.com/logancool/logancool.github.io#readme",
    "dependencies": {
        "@babel/preset-typescript": "^7.18.6",
        "@babel/runtime": "^7.18.9",
        "body-parser": "^1.20.0",
        "browser-cookies": "^1.2.0",
        "copy-webpack-plugin": "^11.0.0",
        "express": "^4.18.1",
        "gh-pages": "^4.0.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router": "^7.18.4",
        "react-router-dom": "^7.18.4",
        "webpack": "^5.74.0"
    },
    "devDependencies": {
        "@babel/core": "^7.18.9",
        "@babel/preset-env": "^7.18.9",
        "@babel/preset-react": "^7.18.6",
        "@dr.pogodin/babel-plugin-react-css-modules": "^7.1.0",
        "@eslint/js": "^9.39.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "autoprefixer": "^10.4.8",
        "babel-loader": "^8.2.5",
        "css-loader": "^6.7.1",
        "cssnano": "^5.1.12",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "file-loader": "^6.0.0",
        "html-webpack-plugin": "^5.5.0",
        "mini-css-extract-plugin": "^2.6.1",
        "postcss": "^8.4.14",
        "postcss-loader": "^8.2.1",
        "postcss-scss": "^4.0.4",
        "prettier": "^3.9.9",
        "sass-embedded": "^1.105.0",
        "sass-loader": "^17.0.1",
        "style-loader": "^4.0.0",
        "stylelint": "^17.15.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.1",
        "url-loader": "^4.1.0",
        "webpack-cli": "^7.2.3",
        "webpack-dev-server": "^6.0.0"
    }
}
